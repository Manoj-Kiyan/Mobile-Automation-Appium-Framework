<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Automation Regression Suite">
    
    <listeners>
        <listener class-name="com.automation.utils.TestListener"></listener>
    </listeners>

    <test name="End To End Mobile Tests">
        <classes>
            <!-- 1. Calculator Business Logic Test -->
            <class name="com.automation.tests.CalculatorPomTest"/>

            <!-- 2. Settings Scroll & Gestures Test -->
            <class name="com.automation.tests.SettingsScrollTest"/>

            <!-- 3. Battery Drop Edge Case Test -->
            <class name="com.automation.tests.BatteryScenarioTest"/>

            <!-- 4. Full Interruption Lifecycle Scenario -->
            <class name="com.automation.tests.SettingsAndBatteryTest"/>
        </classes>
    </test>

</suite>